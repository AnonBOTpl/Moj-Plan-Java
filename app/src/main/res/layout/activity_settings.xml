<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Wróć"
        android:textSize="18sp"
        android:textColor="#007AFF"
        android:padding="8dp"
        android:layout_marginBottom="16dp"/>

    <TextView 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="Ustawienia" 
        android:textSize="22sp" 
        android:textStyle="bold" 
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="24dp"/>

    <TextView 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content" 
        android:text="Kolor akcentu:" 
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="8dp"/>
    <Spinner 
        android:id="@+id/accentColorSpinner" 
        android:layout_width="match_parent" 
        android:layout_height="48dp" 
        android:layout_marginBottom="20dp" />

    <TextView 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content" 
        android:text="Czas powiadomienia:" 
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="8dp"/>
    <Spinner 
        android:id="@+id/notifyTimeSpinner" 
        android:layout_width="match_parent" 
        android:layout_height="48dp" 
        android:layout_marginBottom="20dp" />

    <Switch 
        android:id="@+id/darkModeSwitch" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="Tryb Ciemny" 
        android:paddingVertical="12dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <Switch 
        android:id="@+id/keepScreenOnSwitch" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="Nie usypiaj ekranu" 
        android:paddingVertical="12dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <Switch 
        android:id="@+id/vibrateSwitch" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="Wibracje" 
        android:paddingVertical="12dp"
        android:layout_marginBottom="24dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data przyjęcia:"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="4dp"/>
    <TextView
        android:id="@+id/admissionDateTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wybierz datę"
        android:textSize="16sp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="16dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data wyjścia:"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="4dp"/>
    <TextView
        android:id="@+id/dischargeDateTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wybierz datę"
        android:textSize="16sp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="24dp"
        android:textColor="?android:attr/textColorPrimary"/>

    <Button 
        android:id="@+id/soundButton" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="ZMIEŃ DŹWIĘK POWIADOMIENIA" 
        android:layout_marginBottom="12dp"
        android:textColor="#FFFFFF"/>

    <Button 
        android:id="@+id/testNotificationButton" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:text="TESTUJ POWIADOMIENIE" 
        android:backgroundTint="#34C759" 
        android:textColor="#FFFFFF"/>

</LinearLayout>
</ScrollView>
